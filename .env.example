# Supabase > Project Settings > API
# URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Yalnızca "anon" (public) anahtar. NEXT_PUBLIC_ ile başlayanlar tarayıcıya girer:
# service_role anahtarını ASLA buraya koyma (RLS'yi aşar).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Push bildirimleri (hatırlatma): VAPID public anahtarı. Üretmek için: npx web-push generate-vapid-keys
# Private anahtar buraya YAZILMAZ; sadece Supabase Edge Function secrets'ta tutulur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
